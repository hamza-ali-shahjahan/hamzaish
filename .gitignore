# Hamzaish — root .gitignore
# brain.db is gitignored at brain/.gitignore (it's derived state)

# Reference repos — re-cloned by scripts/install-references.sh, not tracked
references/gbrain/
references/hermes-agent/
references/openclaw/
references/bmad-method/
references/agent-os/
references/metaharness/
references/mattpocock-skills/
references/headroom/
references/graft/
references/adrian/
references/agentenv/
references/openspace/

# Node / build artifacts
node_modules/
dist/
build/
.next/
.turbo/
.wrangler/
out/
.cache/

# Environment / secrets — never commit
.env
.env.*
!.env.example
*.env.local
*.env.production

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Logs
*.log
logs/

# Test output
coverage/
.nyc_output/

# Bun
bun-debug.log
.bun-cache/

# Local-only product code-path map (machine-specific; never commit)
code-paths.local.json

# Local-only operator overrides — personal identity / preferences / context
# Pattern: *.local.<ext> stays on disk but never reaches the repo.
# Templates are committed as *.example.<ext> for forks to copy.
brain/identity/*.local.md
**/*.local.md
**/*.local.json
**/*.local.jsonl
!**/*.example.local.md  # safety: don't accidentally ignore example files

# Auto-commit/push opt-out markers (operator discipline; not source code)
.no-auto-commit
.no-auto-push
.no-auto-pull

# Operator-local research (competitive/strategy docs — never committed)
meta/research/

# ─────────────────────────────────────────────────────────────────────────────
# USER PRODUCTS ARE NOT PART OF THE FACTORY  (added 2026-09-13)
#
# This repo is the TOOL, and it is permanently public. A person's product
# portfolio — roadmap, scope, learnings, decisions, customer-validation notes —
# is THEIR data, not the factory's, and must never be committed here. That holds
# for the maintainer exactly as it holds for a stranger who installs Hamzaish:
# on any machine, the person using the factory is a USER of it.
#
# So: ignore every products/<slug>/ and re-include only the TOOL's own fixtures
# (the template a user copies, the smoke fixtures CI runs, community examples,
# and the empty *.example.md starters setup copies). The portfolio snapshot
# products/_portfolio.md is USER state too — /portfolio-pulse writes a person's
# live business numbers into it — so only its empty starter is tracked.
# scripts/check-user-state.ts enforces this in CI.
#
# Pre-existing check-product-layout.ts covers a narrower case (product CODE in
# this repo). This block covers the rest: product STATE.
products/*
!products/_template/
!products/_smoke/
!products/_community/
!products/README.md
!products/SHOWCASE.md
!products/_portfolio.example.md
!products/_active.example.md

# ...but market-xray raw evidence stays local even inside the re-included
# fixtures: harvested third-party text is never redistributed by this public
# repo (SPEC §Boundaries). The committed layer is the analysis + sources.md
# provenance manifest beside it. MUST stay after the negations above to win.
products/*/research/corpus/
# ─────────────────────────────────────────────────────────────────────────────

# Eval run reports — derived, regenerable verdicts (the committed contract is baseline.json)
meta/evals/runs/

# Internal assessments — operator-local by decision (2026-07-22); never committed
HAMZAISH-PRODUCTION-ASSESSMENT.md

# Security-posture documents (audits, secret inventories, rotation logs) — LOCAL ONLY,
# this repo is always public. Layer 1 of the gate; scripts/check-sensitive-docs.ts is
# the enforcing layer (CI + on demand) in case something sensitive lands outside here.
meta/security/
*SECURITY-AUDIT*
*security-audit*
*secrets-audit*
